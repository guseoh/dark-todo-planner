{
  "name": "dark-todo-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:desktop-ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:desktop-ui": "tsc -b && vite build --base=./",
    "build": "npm run build:desktop-ui && npm run build:worker",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "preview": "wrangler dev --env preview --remote",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "db:backup:preview": "node scripts/backup-d1.mjs preview",
    "db:backup:production": "node scripts/backup-d1.mjs production",
    "auth:hash": "node scripts/hash-password.mjs",
    "deploy:preview": "npm run build:worker && wrangler deploy --env preview",
    "deploy:production": "npm run build:worker && wrangler deploy --env production",
    "build:worker": "tsc -b tsconfig.worker.json && wrangler deploy --dry-run --env=\"\" --outdir .wrangler/build",
    "typecheck:worker": "tsc -b tsconfig.worker.json --pretty false"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "2.12.5",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.18",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
}
