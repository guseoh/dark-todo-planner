{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tern",
  "version": "0.4.0",
  "identifier": "io.github.guseoh.dark-todo-planner",
  "build": {
    "beforeDevCommand": "npm run dev:desktop-ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop-ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Tern",
      "width": 1160,
      "height": 780,
      "minWidth": 720,
      "minHeight": 520,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "__TAURI_UPDATER_PUBLIC_KEY__",
      "endpoints": [
        "https://github.com/guseoh/dark-todo-planner/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
