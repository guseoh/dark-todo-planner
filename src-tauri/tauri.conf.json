{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tern",
  "version": "0.2.0",
  "identifier": "io.github.guseoh.dark-todo-planner",
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": [
        {
          "identifier": "tern-update-settings",
          "windows": ["main"],
          "platforms": ["windows"],
          "local": false,
          "remote": {
            "urls": ["https://dark-todo-planner.guseoh.workers.dev/*"]
          },
          "permissions": ["allow-desktop-update"]
        }
      ]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/guseoh/dark-todo-planner/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGQzg0MDNDOTcxNjIxRDgKUldUWUlSYVhQRURJbndHS1JNME9Nc3NEem1CeEMyRTBWcTl6b2NBVUVQc3g2SDU4QXFCSGFKazMK",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Productivity"
  }
}
