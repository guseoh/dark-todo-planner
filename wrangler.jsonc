{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dark-todo-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "NOTION_CODE_READING_DATA_SOURCE_ID": "1cf805f3-6996-4da7-a1d4-c29408d7ead4",
    "NOTION_TECH_BLOG_DATA_SOURCE_ID": "88f6d67b-9267-417a-b5be-477fb9dad1e8"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-planner-local",
      "database_id": "local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "dark-todo-planner-attachments-local"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "92701",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "92702",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "env": {
    "preview": {
      "name": "dark-todo-planner-preview",
      "vars": {
        "NOTION_CODE_READING_DATA_SOURCE_ID": "1cf805f3-6996-4da7-a1d4-c29408d7ead4",
        "NOTION_TECH_BLOG_DATA_SOURCE_ID": "88f6d67b-9267-417a-b5be-477fb9dad1e8"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dark-todo-planner-preview",
          "database_id": "7f58d3e8-56b4-49a7-985f-4d9360dae673"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "dark-todo-planner-attachments-preview"
        }
      ],
      "ratelimits": [
        {
          "name": "LOGIN_RATE_LIMITER",
          "namespace_id": "92711",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "MUTATION_RATE_LIMITER",
          "namespace_id": "92712",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    },
    "production": {
      "name": "dark-todo-planner",
      "triggers": {
        "crons": ["15 15 * * *", "15 0 * * *", "15 1 * * *", "0 12 * * *", "*/5 * * * *"]
      },
      "vars": {
        "NOTION_CODE_READING_DATA_SOURCE_ID": "1cf805f3-6996-4da7-a1d4-c29408d7ead4",
        "NOTION_TECH_BLOG_DATA_SOURCE_ID": "88f6d67b-9267-417a-b5be-477fb9dad1e8"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dark-todo-planner-production",
          "database_id": "f48e3e51-4635-410b-9e76-e9e0a5be9f4b"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "dark-todo-planner-attachments-production"
        }
      ],
      "ratelimits": [
        {
          "name": "LOGIN_RATE_LIMITER",
          "namespace_id": "92721",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "MUTATION_RATE_LIMITER",
          "namespace_id": "92722",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    }
  }
}
